{
  "port": 8080,
  "host": "0.0.0.0",
  "compression": true,
  "retryBodyLimitBytes": 65536,
  "healthCheck": { "intervalMs": 5000, "timeoutMs": 2000, "path": "/" },
  "routes": [
    {
      "pattern": "/api/*",
      "upstream": [
        { "url": "http://localhost:3000", "weight": 3 },
        "http://localhost:3001"
      ]
    },
    {
      "pattern": "/ws/*",
      "upstream": "http://localhost:3000",
      "ws": true
    },
    {
      "pattern": "/users/:id",
      "upstream": "http://localhost:3000"
    },
    {
      "pattern": "/static/*",
      "static": "./public",
      "fallback": "./public/index.html",
      "cacheControl": "public, max-age=3600"
    }
  ]
}
